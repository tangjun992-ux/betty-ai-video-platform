# Betty AI — Staging go-live env template (test mode)
# Usage: cp .env.staging.example .env.staging && fill values && set -a && source .env.staging && set +a

ENV=development

# Stripe test mode (required for revenue staging)
STRIPE_API_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER_MONTHLY=price_REPLACE_ME
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/pricing?status=cancel

# Bootstrap prices: STRIPE_API_KEY=sk_test_... python scripts/bootstrap_stripe_prices.py --write-env .env.staging
# Local webhook: stripe listen --forward-to localhost:8000/api/v1/billing/stripe/webhook --events checkout.session.completed,invoice.paid

# Media / CDN (production staging — optional in local dev with STORAGE_TYPE=local)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_S3_BUCKET=
# MEDIA_CDN_BASE_URL=https://cdn.example.com

# Live KPI (optional — paid KIE calls)
# MODEL_SMOKE_LIVE=1
# MODEL_SMOKE_LIVE_VIDEO=1

# Ops alerts (optional)
# OPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/...

# OIDC (enterprise optional)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
